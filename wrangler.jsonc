{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "observator",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  // Access を通らない入口を残さない
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "observator.nanase.cc", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // database_id は書かない。初回デプロイ時に自動で作成・紐付けされる
  "d1_databases": [{ "binding": "DB", "database_name": "observator", "migrations_dir": "migrations" }],
  "observability": { "enabled": true },
}
