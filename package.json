{
  "name": "observator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "format": "prettier --write .",
    "cf-typegen": "wrangler types --env-file .dev.vars.example",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@iconify-json/material-symbols": "^1.2.93",
    "@types/node": "26",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/runner": "^4.1",
    "@vitest/snapshot": "^4.1",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.1",
    "vitest": "^4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.140.0"
  },
  "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72"
}
